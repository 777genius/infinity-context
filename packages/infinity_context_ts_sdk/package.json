{
  "name": "@infinity-context/sdk",
  "version": "0.2.1",
  "description": "Production-grade TypeScript SDK for the Infinity Context memory API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/777genius/infinity-context.git",
    "directory": "packages/infinity_context_ts_sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "infinity-context-full-memory-proof": "./scripts/full-memory-proof.mjs",
    "infinity-context-runtime-canary": "./scripts/runtime-canary.mjs",
    "infinity-context-retrieval-runtime-canary": "./scripts/retrieval-runtime-canary.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "import": "./dist/instrumentation.js",
      "require": "./dist/instrumentation.cjs"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js",
      "require": "./dist/pagination.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./canary": {
      "types": "./dist/canary.d.ts",
      "import": "./dist/canary.js",
      "require": "./dist/canary.cjs"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "import": "./dist/proof.js",
      "require": "./dist/proof.cjs"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js",
      "require": "./dist/workflows.cjs"
    },
    "./fixtures/context_retrieval_v2/*.json": {
      "default": "./fixtures/context_retrieval_v2/*.json"
    },
    "./fixtures/document_reconciliation/*.json": {
      "default": "./fixtures/document_reconciliation/*.json"
    }
  },
  "files": [
    "dist",
    "fixtures/context_retrieval_v2",
    "fixtures/document_reconciliation",
    "scripts/check-architecture.mjs",
    "scripts/check-consumer-install.mjs",
    "scripts/check-package-exports.mjs",
    "scripts/full-memory-proof.mjs",
    "scripts/runtime-canary.mjs",
    "scripts/retrieval-runtime-canary.mjs",
    "scripts/retrieval-runtime-canary-policy.mjs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "build": "tsup src/index.ts src/instrumentation.ts src/pagination.ts src/runtime.ts src/canary.ts src/proof.ts src/workflows.ts --format esm,cjs --dts --sourcemap --clean",
    "check:parity": "node scripts/check-api-parity-fixtures.mjs && node scripts/check-api-parity.mjs",
    "check:retrieval-parity": "node scripts/check-retrieval-parity.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:consumer": "node scripts/check-consumer-install.mjs",
    "canary:runtime": "npm run build && node scripts/runtime-canary.mjs",
    "canary:retrieval": "npm run build && node scripts/retrieval-runtime-canary.mjs",
    "release:manifest": "node scripts/sdk-release-manifest.mjs",
    "proof:full-memory": "npm run build && node scripts/full-memory-proof.mjs",
    "lint": "node --check scripts/check-consumer-install.mjs && node --check scripts/sdk-release-manifest.mjs && node --check scripts/sdk-release-receipt.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run check:architecture && npm run check:retrieval-parity && npm run check:parity && npm run typecheck && npm run test && npm run build && npm run check:exports && npm run check:consumer"
  },
  "dependencies": {},
  "overrides": {
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
